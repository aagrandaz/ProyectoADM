{
  "id": null,
  "uid": "next-best-product-dashboard",
  "title": "Next Best Product - ML & Ingestion Observability",
  "description": "Dashboard de monitoreo para el pipeline de datos Medallón, modelo predictivo y herramientas del Servidor MCP.",
  "tags": ["ml", "nbp", "observability", "mcp"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Mimir", "value": "mimir" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 0,
      "title": "",
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "html",
        "content": "<div style=\"background: linear-gradient(135deg, #090d16 0%, #111827 50%, #1f2937 100%); border: 1px solid #3b82f6; border-radius: 8px; padding: 15px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 4px 20px rgba(0,0,0,0.5);\">\n  <div>\n    <h1 style=\"margin: 0; color: #f8fafc; font-size: 24px; font-weight: 700; letter-spacing: -0.025em; text-shadow: 0 0 10px rgba(59,130,246,0.5);\">🚀 Next Best Product (NBP)</h1>\n    <p style=\"margin: 5px 0 0 0; color: #94a3b8; font-size: 14px;\">Plataforma de Monitoreo de Observabilidad Unificada para el Pipeline de Datos Medallón, Rendimiento de Modelos de ML y Herramientas del Servidor MCP.</p>\n  </div>\n  <div style=\"text-align: right;\">\n    <span style=\"background: rgba(59,130,246,0.1); border: 1px solid #3b82f6; color: #60a5fa; padding: 4px 12px; border-radius: 9999px; font-size: 12px; font-weight: 600;\">V2.0 - Premium</span>\n  </div>\n</div>"
      }
    },
    {
      "id": 10,
      "title": "🧠 Inteligencia Artificial: Métricas del Modelo & Explicabilidad",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "🧠 Modelo ROC-AUC (Validación)",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "nbp_model_auc_percent",
          "legendFormat": "ROC-AUC (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "🎯 Modelo Accuracy@1",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "nbp_model_accuracy_top1_percent",
          "legendFormat": "Accuracy@1 (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "green", "value": 25 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "🏆 Modelo Accuracy@3",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "nbp_model_accuracy_top3_percent",
          "legendFormat": "Accuracy@3 (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "🔍 Explicabilidad del Modelo (Importancia de Variables)",
      "type": "barchart",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "nbp_model_feature_importance",
          "legendFormat": "{{feature}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": {
            "orientation": "horizontal",
            "showValue": "always"
          }
        }
      }
    },
    {
      "id": 11,
      "title": "📊 Tubería de Datos: Pipeline de Ingesta Medallón",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "title": "📊 Registros Procesados por Capa (Pipeline Medallón)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "nbp_pipeline_rows_processed_total",
          "legendFormat": "Capa: {{layer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "showValue": "always"
          }
        }
      }
    },
    {
      "id": 8,
      "title": "⏱️ Tiempos de Ejecución del Pipeline (segundos)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "nbp_pipeline_latency_seconds",
          "legendFormat": "Etapa: {{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "showValue": "always"
          }
        }
      }
    },
    {
      "id": 12,
      "title": "📞 Integración con IA: Monitoreo de Herramientas MCP Server",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "title": "📞 Llamadas a Herramientas MCP Server",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "sum(increase(mcp_tool_calls_total[5m])) by (tool_name)",
          "legendFormat": "Herramienta: {{tool_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 3,
            "fillOpacity": 15,
            "gradientMode": "opacity"
          }
        }
      }
    },
    {
      "id": 6,
      "title": "⏱️ Latencia Promedio Herramientas MCP (segundos)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "mcp_tool_latency_seconds_sum / (mcp_tool_latency_seconds_count > 0) or on(tool_name) mcp_tool_calls_total * 0",
          "legendFormat": "Latencia: {{tool_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 3,
            "fillOpacity": 15,
            "gradientMode": "opacity"
          }
        }
      }
    },
    {
      "id": 13,
      "title": "📄 Diagnósticos del Sistema: Logs en Tiempo Real (Loki)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "title": "📄 Visor de Logs del Proyecto (Loki)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{filename=~\"/var/log/proyecto/.*\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
